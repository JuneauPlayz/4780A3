# Copy this file to .env and fill in ONE key. Never commit .env.

# Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=

# auto = Gemini if its key is set, otherwise Groq. Or force: gemini | groq
LLM_PROVIDER=auto

# Optional model overrides. If a model is unavailable the app tries a few known fallbacks.
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
# Groq free tier counts prompt + max answer tokens against 8,000 tokens/minute.
GROQ_MAX_TOKENS=2000
# gpt-oss reasoning effort: low (fast, default) | medium | high
GROQ_REASONING_EFFORT=low
